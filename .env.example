# ============================================================
# 文枢 · 环境变量样例
# 复制为 .env 并填写真实密钥：cp .env.example .env
# ============================================================

# ---------- LLM：DeepSeek（主力对话模型） ----------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TIMEOUT=60

# ---------- 中转站：非 DeepSeek 模型（bge 等，OpenAI 兼容） ----------
RELAY_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RELAY_BASE_URL=https://yunwu.ai/v1
RELAY_MODEL=gpt-5.5

# ---------- Embedding（向量模型，经中转站） ----------
# provider: relay=经中转站；local=本地 sentence-transformers；hash=离线确定性向量（仅开发/测试）
# 注意：该中转站不提供 bge-m3 embedding，可用 text-embedding-3-large(3072)/text-embedding-3-small(1536)
EMBEDDING_PROVIDER=relay
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072

# ---------- 存储 ----------
STORAGE_MODE=mongo            # mongo | memory
MONGO_INITDB_ROOT_USERNAME=wenshu_admin   # MongoDB 根账号（compose 初始化用）
MONGO_INITDB_ROOT_PASSWORD=change-me-strong-mongo-password
REDIS_PASSWORD=change-me-strong-redis-password   # Redis requirepass
MONGODB_URI=mongodb://wenshu_admin:change-me-strong-mongo-password@localhost:27017/wenshu?authSource=admin
MONGODB_DB=wenshu
REDIS_ADDR=redis://:change-me-strong-redis-password@localhost:6379
REDIS_DB=0

# ---------- 检索 ----------
VECTOR_BACKEND=memory         # memory | chroma | milvus
HYBRID_TOPK=5
BM25_TOP=20
VECTOR_TOP=20
RERANKER_ENABLED=true         # 是否启用重排序（经中转站 bge reranker）
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# 显式列出允许的前端来源（生产替换为实际域名；带凭据请求不允许通配符）
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------- pi 智能体服务（Harness + Loop 深度整合） ----------
PI_AGENT_ENABLED=true
PI_AGENT_URL=http://localhost:8100   # Docker 内为 http://pi-agent:8100
INTERNAL_API_TOKEN=change-me-strong-random-token   # 内部接口共享令牌（与后端一致，勿外泄）

# ---------- 上传限制 ----------
MAX_UPLOAD_MB=20                # 文档上传大小上限(MB)

# ---------- 登录限流 ----------
LOGIN_MAX_ATTEMPTS=5            # 登录失败次数上限（窗口内）
LOGIN_WINDOW_SECONDS=300        # 限流窗口(秒)

# ---------- Loop 进化 ----------
LOOP_ENABLED=true
SKILL_MIN_CLUSTER=20          # Skill 挖掘：7 天窗口内同模式问题最小次数
SKILL_SANDBOX_MIN_SUCCESS=0.85
HOOK_HIGH_CONFIDENCE=0.9      # 高置信度自动生效阈值（人在环上/环外）
LOOP_PHASE=human_in_loop      # human_in_loop | human_on_loop | human_out_of_loop（Phase 1 起步，逐步退出）

# ---------- 鉴权 ----------
AUTH_SECRET=change-me-strong-random-secret   # Token 签名密钥（生产务必改为强随机值）
AUTH_TOKEN_TTL_HOURS=24
SEED_DEMO_USERS=true           # 演示账号开关（student/student123、admin/admin123）；生产务必 false

# ---------- 人工审核 Loop（部门渐进退出） ----------
REVIEW_QUESTION_COUNT=3         # 新文档入库后自动生成的测试题数量
REVIEW_ACCURACY_THRESHOLD=0.8   # 正确率超过该阈值后取消人工审核（人退出 Loop）
REVIEW_MIN_SAMPLES=5            # 达到阈值所需的最小审核样本数（积累反馈）
