# 复制为 secrets.yaml 并填写真实密钥后 apply
# 注意：所有密钥均为占位符，部署前务必替换为强随机值（可参考根目录 .env 中已生成的值）
apiVersion: v1
kind: Secret
metadata:
  name: wenshu-secrets
  namespace: wenshu
type: Opaque
stringData:
  DEEPSEEK_API_KEY: "sk-xxxxxxxx"
  RELAY_API_KEY: "sk-xxxxxxxx"
  # Token 签名密钥与内部接口令牌（强随机，且 backend 与 pi-agent 必须一致）
  AUTH_SECRET: "change-me-strong-random-secret"
  INTERNAL_API_TOKEN: "change-me-strong-random-token"
  # 数据库凭据（mongodb 初始化根账号；redis requirepass）
  MONGO_INITDB_ROOT_USERNAME: "wenshu_admin"
  MONGO_INITDB_ROOT_PASSWORD: "change-me-strong-mongo-password"
  REDIS_PASSWORD: "change-me-strong-redis-password"
  MONGODB_URI: "mongodb://wenshu_admin:change-me-strong-mongo-password@mongodb:27017/wenshu?authSource=admin"
  REDIS_ADDR: "redis://:change-me-strong-redis-password@redis:6379"
