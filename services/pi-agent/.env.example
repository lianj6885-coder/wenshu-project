# pi-agent 服务环境变量（Docker 由 compose 注入；本地可复制为 .env）
PORT=8100
HOST=0.0.0.0
BACKEND_URL=http://localhost:8000
# 调用后端 /internal/* 的共享令牌（必须与后端 INTERNAL_API_TOKEN 一致）
INTERNAL_API_TOKEN=change-me-strong-random-token

# DeepSeek（主力对话模型）
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 中转站（非 DeepSeek 模型）
RELAY_API_KEY=sk-xxxxxxxx
RELAY_BASE_URL=https://yunwu.ai/v1
RELAY_MODEL=gpt-5.5

# Loop
LOOP_ENABLED=true
LOOP_PHASE=human_on_loop
HOOK_HIGH_CONFIDENCE=0.9
